{
    "name": "wc-bom-stock",
    "private": true,
    "version": "0.1.0",
    "scripts": {
        "start": "wp-scripts start assets/src/bom-editor/index.js --output-path=assets/build/bom-editor",
        "build": "wp-scripts build assets/src/bom-editor/index.js --output-path=assets/build/bom-editor",
        "env:start": "wp-env start",
        "env:stop": "wp-env stop",
        "env:destroy": "wp-env destroy",
        "env:seed": "wp-env run cli wp wcbom seed",
        "env:seed:reset": "wp-env run cli wp wcbom seed --reset",
        "lint:php": "vendor/bin/phpcs",
        "lint:php:fix": "vendor/bin/phpcbf",
        "analyze": "vendor/bin/phpstan analyse --memory-limit=1536M"
    },
    "devDependencies": {
        "@babel/runtime": "^8.0.0",
        "@wordpress/env": "^10.0.0",
        "@wordpress/scripts": "^28.0.0"
    }
}
