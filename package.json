    },
    "devDependencies": {
        "@babel/runtime": "^8.0.0",
        "@wordpress/env": "^10.0.0",
        "@wordpress/scripts": "^28.0.0",
        "playwright": "^1.62.1",
        "sharp": "^0.35.3"
    }
