includes:
    - vendor/szepeviktor/phpstan-wordpress/extension.neon

parameters:
    level: 6
    parallel:
        # The WooCommerce stubs are large enough that parallel workers each
        # loading their own copy reliably exhausts memory; keep this serial.
        maximumNumberOfProcesses: 1
    paths:
        - src
        - wc-bom-stock.php
        - uninstall.php
    excludePaths:
        - vendor (?)
        - node_modules (?)
    bootstrapFiles:
        - vendor/php-stubs/woocommerce-stubs/woocommerce-stubs.php
        - vendor/php-stubs/wp-cli-stubs/wp-cli-stubs.php
    dynamicConstantNames:
        # The WooCommerce stubs define this as a fixed dummy literal
        # ('0.0.0'), which makes any version_compare() against it get
        # constant-folded to a fake, always-true/false result — its real
        # value depends entirely on the installed WC version, never known
        # statically. Same treatment the extension itself gives WP_DEBUG etc.
        - WC_VERSION
